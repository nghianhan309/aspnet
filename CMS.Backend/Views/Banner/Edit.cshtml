@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Chỉnh sửa Banner";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-0 rounded-4 max-w-2xl mx-auto" style="max-width: 800px;">
    <div class="card-header bg-white border-0 pt-4 pb-0">
        <h5 class="mb-0 fw-bold" style="color:var(--text-main);">Cập nhật Banner</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-medium text-muted"></label>
                <input asp-for="Title" class="form-control rounded-3 py-2" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-medium text-muted">Hình ảnh hiện tại</label>
                <div>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="Current Banner" class="img-thumbnail rounded" style="max-height: 150px; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Không có ảnh</span>
                    }
                </div>
                <div class="mt-2">
                    <label class="form-label fw-medium text-muted small">Tải ảnh mới lên (để trống nếu muốn giữ ảnh cũ)</label>
                    <input type="file" id="imageInput" name="imageFile" class="form-control rounded-3 py-2" accept="image/*" />
                </div>
                <div class="mt-3 d-none" id="imagePreviewContainer">
                    <p class="text-muted small mb-1">Xem trước ảnh mới:</p>
                    <img id="imagePreview" src="#" alt="Preview" class="img-thumbnail rounded shadow-sm" style="max-height: 200px; object-fit: cover;" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Link" class="form-label fw-medium text-muted"></label>
                <input asp-for="Link" class="form-control rounded-3 py-2" />
                <span asp-validation-for="Link" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DisplayOrder" class="form-label fw-medium text-muted"></label>
                    <input asp-for="DisplayOrder" class="form-control rounded-3 py-2" type="number" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3 d-flex align-items-end pb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" style="width: 2.5em; height: 1.25em;">
                        <label class="form-check-label ms-2" asp-for="IsActive" style="margin-top: 3px;">Kích hoạt</label>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-3 px-4">Lưu cập nhật</button>
                <a asp-action="Index" class="btn btn-light rounded-3 px-4 border">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('imageInput').addEventListener('change', function (e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('imagePreviewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            } else {
                document.getElementById('imagePreviewContainer').classList.add('d-none');
            }
        });
    </script>
}
