@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Thêm quản trị viên mới";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4" style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="card-header border-0 py-4" style="background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 1rem 1rem 0 0;">
                    <h3 class="mb-0 fw-bold" style="background: linear-gradient(135deg, #38bdf8, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        <i class="fas fa-user-plus me-2" style="color: #38bdf8;"></i>THÊM QUẢN TRỊ VIÊN MỚI
                    </h3>
                </div>

                <div class="card-body p-4 text-light">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Username" class="form-label fw-bold" style="color: #e2e8f0;">Tên đăng nhập <span class="text-danger">*</span></label>
                            <input asp-for="Username" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" placeholder="Nhập username (viết liền không dấu)..." />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PasswordHash" class="form-label fw-bold" style="color: #e2e8f0;">Mật khẩu <span class="text-danger">*</span></label>
                            <input asp-for="PasswordHash" type="password" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" placeholder="Nhập mật khẩu..." />
                            <span asp-validation-for="PasswordHash" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FullName" class="form-label fw-bold" style="color: #e2e8f0;">Họ và Tên</label>
                            <input asp-for="FullName" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" placeholder="Nhập họ tên đầy đủ..." />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Role" class="form-label fw-bold" style="color: #e2e8f0;">Vai trò phân quyền</label>
                            <select asp-for="Role" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;">
                                <option value="Editor" class="text-dark">Editor (Người đăng bài)</option>
                                <option value="Admin" class="text-dark">Admin (Quản trị viên cấp cao)</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold" style="background: linear-gradient(135deg, #38bdf8, #818cf8); border: none; box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);">
                                <i class="fas fa-save me-1"></i> Lưu tài khoản
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-4 py-2 rounded-pill fw-semibold" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #f8fafc;">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
