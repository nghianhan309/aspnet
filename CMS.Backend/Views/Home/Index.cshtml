@using CMS.Data.Entities
@{
    ViewData["Title"] = "Dashboard";
    int totalProducts  = ViewBag.TotalProducts  ?? 0;
    int totalOrders    = ViewBag.TotalOrders    ?? 0;
    int totalCustomers = ViewBag.TotalCustomers ?? 0;
    int totalCategories = ViewBag.TotalCategories ?? 0;
    int pendingOrders  = ViewBag.PendingOrders  ?? 0;
    int shippingOrders = ViewBag.ShippingOrders ?? 0;
    int doneOrders     = ViewBag.DoneOrders     ?? 0;
    var recentOrders   = ViewBag.RecentOrders as List<Order> ?? new List<Order>();
}

<!-- ===== TOP STAT CARDS ===== -->
<div class="row g-4 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="--c:#7C3AED; --cl:#EDE9FE;">
            <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
            <div class="stat-body">
                <div class="stat-label">Tổng đơn hàng</div>
                <div class="stat-value">@totalOrders</div>
                <div class="stat-sub"><span class="badge-success">+@pendingOrders chờ duyệt</span></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="--c:#3B82F6; --cl:#DBEAFE;">
            <div class="stat-icon"><i class="fas fa-box-open"></i></div>
            <div class="stat-body">
                <div class="stat-label">Sản phẩm</div>
                <div class="stat-value">@totalProducts</div>
                <div class="stat-sub"><span class="badge-blue">@totalCategories danh mục</span></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="--c:#22C55E; --cl:#DCFCE7;">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-body">
                <div class="stat-label">Khách hàng</div>
                <div class="stat-value">@totalCustomers</div>
                <div class="stat-sub"><span class="badge-green">Đã đăng ký</span></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card" style="--c:#F59E0B; --cl:#FEF3C7;">
            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
            <div class="stat-body">
                <div class="stat-label">Hoàn thành</div>
                <div class="stat-value">@doneOrders</div>
                <div class="stat-sub"><span class="badge-amber">@shippingOrders đang giao</span></div>
            </div>
        </div>
    </div>
</div>

<!-- ===== CHARTS ROW ===== -->
<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="dash-card">
            <div class="dash-card-header">
                <div>
                    <h6 class="dash-card-title">Doanh thu 7 ngày gần nhất</h6>
                    <span class="dash-card-sub">Biểu đồ đường theo ngày</span>
                </div>
                <span class="badge-purple">Chart.js</span>
            </div>
            <div class="dash-card-body">
                <canvas id="revenueChart" height="100"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <div>
                    <h6 class="dash-card-title">Trạng thái đơn hàng</h6>
                    <span class="dash-card-sub">Phân bổ theo tình trạng</span>
                </div>
            </div>
            <div class="dash-card-body d-flex align-items-center justify-content-center">
                <div style="max-width: 220px; width:100%;">
                    <canvas id="orderStatusChart"></canvas>
                </div>
            </div>
            <div class="chart-legend">
                <div class="legend-item"><span style="background:#7C3AED;"></span>Chờ duyệt (@pendingOrders)</div>
                <div class="legend-item"><span style="background:#3B82F6;"></span>Đang giao (@shippingOrders)</div>
                <div class="legend-item"><span style="background:#22C55E;"></span>Hoàn thành (@doneOrders)</div>
            </div>
        </div>
    </div>
</div>

<!-- ===== RECENT ORDERS + QUICK LINKS ===== -->
<div class="row g-4">
    <div class="col-xl-8">
        <div class="dash-card">
            <div class="dash-card-header">
                <div>
                    <h6 class="dash-card-title">Đơn hàng gần đây</h6>
                    <span class="dash-card-sub">5 đơn hàng mới nhất</span>
                </div>
                <a asp-controller="Order" asp-action="Index" class="btn-link-purple">Xem tất cả <i class="fas fa-arrow-right ms-1" style="font-size:0.7rem;"></i></a>
            </div>
            <div class="dash-card-body p-0">
                <table class="saas-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentOrders.Any())
                        {
                            foreach (var o in recentOrders)
                            {
                                string statusText = o.Status == 0 ? "Chờ duyệt" : o.Status == 1 ? "Đang giao" : "Hoàn thành";
                                string statusClass = o.Status == 0 ? "status-pending" : o.Status == 1 ? "status-shipping" : "status-done";
                                <tr>
                                    <td><span class="order-id">#@o.Id</span></td>
                                    <td>
                                        <div class="customer-cell">
                                            <div class="avatar-sm">@((o.Customer?.FullName ?? "?").Substring(0, 1).ToUpper())</div>
                                            <span>@(o.Customer?.FullName ?? "---")</span>
                                        </div>
                                    </td>
                                    <td class="text-muted-sm">@o.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="status-badge @statusClass">@statusText</span></td>
                                    <td class="text-end">
                                        <a asp-controller="Order" asp-action="Edit" asp-route-id="@o.Id" class="icon-btn edit" title="Sửa"><i class="fas fa-edit"></i></a>
                                        <a asp-controller="Order" asp-action="Delete" asp-route-id="@o.Id" class="icon-btn delete" title="Xóa"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fs-3 d-block mb-2 text-muted" style="opacity:0.4;"></i>
                                    Chưa có đơn hàng nào
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <h6 class="dash-card-title">Truy cập nhanh</h6>
            </div>
            <div class="dash-card-body">
                <div class="quick-links">
                    <a asp-controller="Product" asp-action="Create" class="quick-link" style="--qc:#7C3AED;">
                        <div class="quick-link-icon"><i class="fas fa-plus-circle"></i></div>
                        <div>
                            <div class="quick-link-title">Thêm sản phẩm</div>
                            <div class="quick-link-sub">Tạo sản phẩm mới</div>
                        </div>
                        <i class="fas fa-chevron-right ms-auto" style="font-size:0.7rem; color:#9CA3AF;"></i>
                    </a>
                    <a asp-controller="Order" asp-action="Create" class="quick-link" style="--qc:#3B82F6;">
                        <div class="quick-link-icon" style="background:#DBEAFE;"><i class="fas fa-cart-plus" style="color:#3B82F6;"></i></div>
                        <div>
                            <div class="quick-link-title">Tạo đơn hàng</div>
                            <div class="quick-link-sub">Nhập đơn thủ công</div>
                        </div>
                        <i class="fas fa-chevron-right ms-auto" style="font-size:0.7rem; color:#9CA3AF;"></i>
                    </a>
                    <a asp-controller="Customer" asp-action="Create" class="quick-link" style="--qc:#22C55E;">
                        <div class="quick-link-icon" style="background:#DCFCE7;"><i class="fas fa-user-plus" style="color:#22C55E;"></i></div>
                        <div>
                            <div class="quick-link-title">Thêm khách hàng</div>
                            <div class="quick-link-sub">Đăng ký tài khoản</div>
                        </div>
                        <i class="fas fa-chevron-right ms-auto" style="font-size:0.7rem; color:#9CA3AF;"></i>
                    </a>
                    <a asp-controller="Post" asp-action="Create" class="quick-link" style="--qc:#F59E0B;">
                        <div class="quick-link-icon" style="background:#FEF3C7;"><i class="fas fa-pen" style="color:#F59E0B;"></i></div>
                        <div>
                            <div class="quick-link-title">Đăng bài viết</div>
                            <div class="quick-link-sub">Viết nội dung mới</div>
                        </div>
                        <i class="fas fa-chevron-right ms-auto" style="font-size:0.7rem; color:#9CA3AF;"></i>
                    </a>
                    <a href="/swagger" target="_blank" class="quick-link" style="--qc:#6B7280;">
                        <div class="quick-link-icon" style="background:#F3F4F6;"><i class="fas fa-code" style="color:#6B7280;"></i></div>
                        <div>
                            <div class="quick-link-title">Swagger API</div>
                            <div class="quick-link-sub">Tài liệu API REST</div>
                        </div>
                        <i class="fas fa-chevron-right ms-auto" style="font-size:0.7rem; color:#9CA3AF;"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== STYLES ===== -->
<style>
    /* --- Stat Cards --- */
    .stat-card {
        background: white;
        border: 1px solid #E5E7EB;
        border-radius: 16px;
        padding: 22px;
        display: flex;
        gap: 16px;
        align-items: flex-start;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
    .stat-icon {
        width: 48px; height: 48px;
        background: var(--cl);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem;
        color: var(--c);
        flex-shrink: 0;
    }
    .stat-label { font-size: 0.78rem; font-weight: 600; color: #6B7280; text-transform: uppercase; letter-spacing: 0.05em; }
    .stat-value { font-size: 2rem; font-weight: 800; color: #111827; line-height: 1.2; margin: 2px 0; }
    .stat-sub { margin-top: 4px; }

    .badge-success, .badge-blue, .badge-green, .badge-amber, .badge-purple {
        display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: 0.72rem; font-weight: 600;
    }
    .badge-success { background: #EDE9FE; color: #7C3AED; }
    .badge-blue    { background: #DBEAFE; color: #3B82F6; }
    .badge-green   { background: #DCFCE7; color: #16A34A; }
    .badge-amber   { background: #FEF3C7; color: #D97706; }
    .badge-purple  { background: #EDE9FE; color: #7C3AED; }

    /* --- Dash Card --- */
    .dash-card {
        background: white;
        border: 1px solid #E5E7EB;
        border-radius: 16px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        display: flex;
        flex-direction: column;
    }
    .dash-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #F3F4F6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .dash-card-title { font-size: 0.92rem; font-weight: 700; color: #111827; margin: 0; }
    .dash-card-sub   { font-size: 0.75rem; color: #9CA3AF; margin-top: 2px; display: block; }
    .dash-card-body  { padding: 20px; flex-grow: 1; }

    .btn-link-purple {
        font-size: 0.8rem; font-weight: 600; color: #7C3AED;
        text-decoration: none; white-space: nowrap;
        transition: opacity 0.2s;
    }
    .btn-link-purple:hover { opacity: 0.7; }

    /* --- Table --- */
    .saas-table { width: 100%; border-collapse: collapse; }
    .saas-table thead th {
        padding: 10px 20px; font-size: 0.72rem; font-weight: 700;
        color: #6B7280; text-transform: uppercase; letter-spacing: 0.06em;
        background: #F9FAFB; border-bottom: 1px solid #E5E7EB;
    }
    .saas-table tbody td {
        padding: 13px 20px; font-size: 0.85rem; color: #374151;
        border-bottom: 1px solid #F3F4F6; vertical-align: middle;
    }
    .saas-table tbody tr:last-child td { border-bottom: none; }
    .saas-table tbody tr { transition: background 0.15s; }
    .saas-table tbody tr:hover { background: #F9FAFB; }

    .order-id { font-weight: 700; color: #7C3AED; }
    .text-muted-sm { color: #9CA3AF !important; font-size: 0.82rem; }

    .customer-cell { display: flex; align-items: center; gap: 9px; }
    .avatar-sm {
        width: 30px; height: 30px; border-radius: 50%;
        background: #EDE9FE; color: #7C3AED;
        font-weight: 700; font-size: 0.78rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    /* Status Badges */
    .status-badge {
        display: inline-block; padding: 3px 10px;
        border-radius: 20px; font-size: 0.75rem; font-weight: 600;
    }
    .status-pending  { background: #FEF3C7; color: #D97706; }
    .status-shipping { background: #DBEAFE; color: #2563EB; }
    .status-done     { background: #DCFCE7; color: #16A34A; }

    /* Action Buttons */
    .icon-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 7px;
        font-size: 0.78rem; transition: all 0.2s; margin-left: 4px;
        text-decoration: none;
    }
    .icon-btn.edit   { background: #FEF3C7; color: #D97706; }
    .icon-btn.edit:hover   { background: #F59E0B; color: white; transform: translateY(-1px); }
    .icon-btn.delete { background: #FEE2E2; color: #EF4444; }
    .icon-btn.delete:hover { background: #EF4444; color: white; transform: translateY(-1px); }

    /* Chart Legend */
    .chart-legend { padding: 0 20px 16px; display: flex; flex-direction: column; gap: 8px; }
    .legend-item  { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: #374151; }
    .legend-item span {
        width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
    }

    /* Quick Links */
    .quick-links { display: flex; flex-direction: column; gap: 6px; }
    .quick-link {
        display: flex; align-items: center; gap: 12px;
        padding: 11px 14px; border-radius: 11px;
        background: #FAFAFA; border: 1px solid #F3F4F6;
        text-decoration: none; transition: all 0.2s;
    }
    .quick-link:hover {
        background: var(--accent-light, #EDE9FE);
        border-color: rgba(124,58,237,0.2);
        transform: translateX(3px);
    }
    .quick-link-icon {
        width: 36px; height: 36px; border-radius: 9px;
        background: #EDE9FE; display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; font-size: 0.9rem; color: #7C3AED;
    }
    .quick-link-title { font-size: 0.85rem; font-weight: 600; color: #111827; }
    .quick-link-sub   { font-size: 0.75rem; color: #9CA3AF; }
</style>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // --- Line Chart: Revenue 7 days ---
    const ctx1 = document.getElementById('revenueChart').getContext('2d');
    new Chart(ctx1, {
        type: 'line',
        data: {
            labels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: [1200000, 1900000, 1500000, 2800000, 2200000, 3500000, 2900000],
                borderColor: '#7C3AED',
                backgroundColor: 'rgba(124,58,237,0.08)',
                borderWidth: 2.5,
                pointBackgroundColor: '#7C3AED',
                pointRadius: 4,
                pointHoverRadius: 6,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#1F2937',
                    titleColor: '#F9FAFB',
                    bodyColor: '#D1D5DB',
                    padding: 12,
                    cornerRadius: 8,
                    callbacks: {
                        label: ctx => ' ' + ctx.raw.toLocaleString('vi-VN') + ' ₫'
                    }
                }
            },
            scales: {
                x: { grid: { display: false }, ticks: { color: '#9CA3AF', font: { size: 12 } } },
                y: {
                    grid: { color: '#F3F4F6' },
                    ticks: {
                        color: '#9CA3AF', font: { size: 11 },
                        callback: v => (v / 1000000).toFixed(1) + 'M'
                    }
                }
            }
        }
    });

    // --- Doughnut Chart: Order Status ---
    const ctx2 = document.getElementById('orderStatusChart').getContext('2d');
    new Chart(ctx2, {
        type: 'doughnut',
        data: {
            labels: ['Chờ duyệt', 'Đang giao', 'Hoàn thành'],
            datasets: [{
                data: [@pendingOrders, @shippingOrders, @doneOrders],
                backgroundColor: ['#7C3AED', '#3B82F6', '#22C55E'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            cutout: '72%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#1F2937',
                    titleColor: '#F9FAFB',
                    bodyColor: '#D1D5DB',
                    padding: 12,
                    cornerRadius: 8
                }
            }
        }
    });
</script>
}