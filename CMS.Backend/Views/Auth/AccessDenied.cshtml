@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Từ chối truy cập - NEXUS CMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #0b0f19;
            color: #e2e8f0;
            font-family: 'Outfit', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .error-card {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.5rem;
            padding: 4rem 3rem;
            text-align: center;
            max-width: 500px;
        }
    </style>
</head>
<body>
    <div class="error-card shadow-lg">
        <i class="fas fa-lock text-danger" style="font-size: 5rem; margin-bottom: 1.5rem; opacity: 0.8;"></i>
        <h2 class="text-white fw-bold mb-3">TỪ CHỐI TRUY CẬP</h2>
        <p class="text-secondary mb-4">Bạn không có quyền truy cập vào khu vực này. Vui lòng liên hệ Admin nếu bạn cho rằng đây là một sự nhầm lẫn.</p>
        <a href="/" class="btn btn-primary rounded-pill px-4" style="background: linear-gradient(135deg, #38bdf8, #818cf8); border: none;">
            <i class="fas fa-home me-2"></i> Về trang chủ
        </a>
    </div>
</body>
</html>
