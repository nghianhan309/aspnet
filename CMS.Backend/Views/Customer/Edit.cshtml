@model CMS.Data.Entities.Customer

@{
    ViewData["Title"] = "Cập nhật Khách hàng";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4" style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="card-header border-0 py-4" style="background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 1rem 1rem 0 0;">
                    <h3 class="mb-0 fw-bold" style="background: linear-gradient(135deg, #f6c23e, #f4b619); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        <i class="fas fa-user-edit me-2" style="color: #f6c23e;"></i>CẬP NHẬT THÔNG TIN
                    </h3>
                </div>

                <div class="card-body p-4 text-light">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="FullName" class="form-label fw-bold" style="color: #e2e8f0;">Họ và tên <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Email" class="form-label fw-bold" style="color: #e2e8f0;">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Phone" class="form-label fw-bold" style="color: #e2e8f0;">Số điện thoại</label>
                                <input asp-for="Phone" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Password" class="form-label fw-bold" style="color: #e2e8f0;">Mật khẩu <span class="text-danger">*</span></label>
                                <input asp-for="Password" type="text" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Address" class="form-label fw-bold" style="color: #e2e8f0;">Địa chỉ</label>
                            <input asp-for="Address" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-warning px-4 py-2 rounded-pill fw-semibold border-0 text-dark" style="box-shadow: 0 4px 15px rgba(246, 194, 62, 0.3);">
                                <i class="fas fa-check-circle me-1"></i> Cập nhật
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-4 py-2 rounded-pill fw-semibold" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #f8fafc;">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
