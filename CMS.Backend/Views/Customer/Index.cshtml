@model IEnumerable<CMS.Data.Entities.Customer>

@{
    ViewData["Title"] = "Khách hàng";
}

<div class="container-fluid px-0">
    <div class="saas-card">

        <!-- HEADER -->
        <div class="saas-card-header">
            <div>
                <h3 class="mb-0 text-white fw-bold">
                    <i class="fas fa-users me-2"></i>DANH SÁCH KHÁCH HÀNG
                </h3>
                <p class="text-white-50 small mb-0">Tổng cộng @(Model?.Count() ?? 0) khách hàng đã đăng ký</p>
            </div>
            <a asp-action="Create" class="btn btn-add-new">
                <i class="fas fa-user-plus me-1"></i> Thêm khách hàng
            </a>
        </div>

        <!-- TABLE -->
        <div class="p-0">
            <table class="table table-hover mb-0 saas-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4" style="width:6%">ID</th>
                        <th style="width:25%">Khách hàng</th>
                        <th style="width:25%">Email</th>
                        <th style="width:15%">Số điện thoại</th>
                        <th style="width:17%">Địa chỉ</th>
                        <th class="text-end pe-4" style="width:12%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var initial = !string.IsNullOrEmpty(item.FullName)
                                ? item.FullName.Trim().Substring(0, 1).ToUpper() : "?";
                            var avatarColors = new[] {
                                ("bg1","#7C3AED"),("bg2","#3B82F6"),("bg3","#22C55E"),
                                ("bg4","#F59E0B"),("bg5","#EF4444"),("bg6","#06B6D4")
                            };
                            var color = avatarColors[item.Id % avatarColors.Length].Item2;

                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-dark border">#@item.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="cust-avatar" style="background:@color;">
                                            @initial
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.FullName</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted">@item.Email</td>
                                <td class="text-muted">@(item.Phone ?? "—")</td>
                                <td class="text-muted text-truncate" style="max-width:160px;">
                                    @(item.Address ?? "—")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm border-0 mx-1" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm border-0 mx-1" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-user-slash fs-1 mb-3 d-block" style="opacity:.3;"></i>
                                Chưa có khách hàng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="saas-card-footer">
            <small class="text-muted">Hiển thị tổng số @(Model?.Count() ?? 0) khách hàng</small>
        </div>
    </div>
</div>

@await Html.PartialAsync("_SaasTableStyle")

<style>
    .cust-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        color: #fff; font-weight: 700; font-size: 0.9rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
</style>