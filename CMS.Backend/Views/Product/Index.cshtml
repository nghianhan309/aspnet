@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="container-fluid px-0">
    <div class="saas-card">

        <!-- HEADER -->
        <div class="saas-card-header">
            <div>
                <h3 class="mb-0 text-white fw-bold">
                    <i class="fas fa-box-open me-2"></i>DANH SÁCH SẢN PHẨM
                </h3>
                <p class="text-white-50 small mb-0">Quản lý kho hàng và thông tin sản phẩm</p>
            </div>
            <a asp-action="Create" class="btn btn-add-new">
                <i class="fas fa-plus-circle me-1"></i> Thêm sản phẩm
            </a>
        </div>

        <!-- TABLE -->
        <div class="p-0">
            <table class="table table-hover mb-0 saas-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4" style="width:5%">ID</th>
                        <th style="width:10%">Hình ảnh</th>
                        <th style="width:25%">Tên sản phẩm</th>
                        <th style="width:15%">Loại sản phẩm</th>
                        <th style="width:15%">Giá bán</th>
                        <th style="width:10%">Tồn kho</th>
                        <th class="text-end pe-4" style="width:20%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4"><span class="badge bg-light text-dark border">#@item.Id</span></td>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/80x80?text=No+Img" : Url.Content(item.ImageUrl.StartsWith("http") || item.ImageUrl.StartsWith("/") ? item.ImageUrl : "~/" + item.ImageUrl))"
                                         class="rounded-3 shadow-sm" style="width:60px;height:60px;object-fit:cover;" alt="@item.Name" />
                                </td>
                                <td><span class="fw-bold text-primary">@item.Name</span></td>
                                <td>
                                    <span class="badge bg-info text-dark">@(item.CategoryProduct?.Name ?? "Chưa phân loại")</span>
                                </td>
                                <td><span class="fw-bold text-danger">@item.Price.ToString("N0") ₫</span></td>
                                <td>
                                    @if (item.StockQuantity > 0)
                                    {
                                        <span class="badge bg-success">@item.StockQuantity</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Hết hàng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm border-0 mx-1" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-info btn-sm border-0 mx-1" title="Chi tiết">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm border-0 mx-1" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-box-open fs-1 mb-3 d-block" style="opacity:.3;"></i>
                                Chưa có sản phẩm nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="saas-card-footer">
            <small class="text-muted">Hiển thị tổng số @(Model?.Count() ?? 0) sản phẩm</small>
        </div>
    </div>
</div>

@await Html.PartialAsync("_SaasTableStyle")