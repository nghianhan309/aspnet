@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Cập nhật Sản phẩm";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header py-3" style="background: linear-gradient(135deg, #2d2000, #3d2e00); border-radius: 1rem 1rem 0 0; border-bottom: 1px solid rgba(250,189,0,0.2);">
            <h4 class="mb-0" style="color: #fff;"><i class="fas fa-edit me-2" style="color: #fcd34d;"></i>Cập Nhật Sản Phẩm</h4>
        </div>
        <div class="card-body p-4" style="background: rgba(15,23,42,0.95);">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="mb-3">
                            <div class="text-center mb-3">
                                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/150x150?text=No+Img" : Model.ImageUrl)" 
                                     class="img-thumbnail shadow-sm" style="max-height: 150px; object-fit: cover;" alt="Preview" />
                            </div>
                            <input type="hidden" asp-for="ImageUrl" />
                            <label class="form-label fw-bold">Chọn ảnh mới (để trống nếu giữ nguyên)</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryProductId" class="form-label fw-bold">Loại sản phẩm <span class="text-danger">*</span></label>
                            <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryProductId"></select>
                            <span asp-validation-for="CategoryProductId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="Price" class="form-control" type="number" step="1000" min="0" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                            <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4 fw-bold text-dark">
                        <i class="fas fa-save me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .form-label { color: #94a3b8 !important; font-size: 0.82rem; letter-spacing: 0.05rem; text-transform: uppercase; font-weight: 600; }
    .form-control, .form-select {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        color: #f1f5f9 !important;
        border-radius: 8px;
    }
    .form-control::placeholder { color: rgba(148, 163, 184, 0.6) !important; }
    .form-control:focus, .form-select:focus {
        background: rgba(252, 211, 77, 0.08) !important;
        border-color: #fcd34d !important;
        box-shadow: 0 0 0 3px rgba(252, 211, 77, 0.15) !important;
        color: #fff !important;
    }
    .form-select option { background: #1e293b; color: #f1f5f9; }
    textarea.form-control { color: #f1f5f9 !important; }
    .card { border: 1px solid rgba(255,255,255,0.08) !important; border-radius: 1rem !important; }
    .text-danger { color: #f87171 !important; }
    hr { border-color: rgba(255,255,255,0.08) !important; }
    .img-thumbnail { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); }
    .btn-warning { background: linear-gradient(135deg, #f59e0b, #fcd34d) !important; border: none !important; color: #1e293b !important; font-weight: 700; }
    .btn-warning:hover { filter: brightness(1.1); transform: translateY(-1px); }
</style>
