@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Thêm mới Sản phẩm";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header py-3" style="background: linear-gradient(135deg, #1e3a5f, #1a2744); border-radius: 1rem 1rem 0 0; border-bottom: 1px solid rgba(56,189,248,0.2);">
            <h4 class="mb-0" style="color: #fff;"><i class="fas fa-plus-circle me-2" style="color: #38bdf8;"></i>Thêm Sản Phẩm Mới</h4>
        </div>
        <div class="card-body p-4" style="background: rgba(15,23,42,0.95);">
            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập mô tả sản phẩm..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CategoryProductId" class="form-label fw-bold">Loại sản phẩm <span class="text-danger">*</span></label>
                            <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryProductId">
                                <option value="">-- Chọn loại sản phẩm --</option>
                            </select>
                            <span asp-validation-for="CategoryProductId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="Price" class="form-control" type="number" step="1000" min="0" placeholder="0" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                            <input asp-for="StockQuantity" class="form-control" type="number" min="0" placeholder="0" />
                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Ảnh sản phẩm</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i> Lưu dữ liệu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .form-label { color: #94a3b8 !important; font-size: 0.82rem; letter-spacing: 0.05rem; text-transform: uppercase; font-weight: 600; }
    .form-control, .form-select {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        color: #f1f5f9 !important;
        border-radius: 8px;
    }
    .form-control::placeholder { color: rgba(148, 163, 184, 0.6) !important; }
    .form-control:focus, .form-select:focus {
        background: rgba(56, 189, 248, 0.08) !important;
        border-color: #38bdf8 !important;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15) !important;
        color: #fff !important;
    }
    .form-select option { background: #1e293b; color: #f1f5f9; }
    textarea.form-control { color: #f1f5f9 !important; }
    .card { border: 1px solid rgba(255,255,255,0.08) !important; border-radius: 1rem !important; }
    .text-danger { color: #f87171 !important; }
    hr { border-color: rgba(255,255,255,0.08) !important; }
</style>
