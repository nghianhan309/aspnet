@model CMS.Data.Entities.CategoryProduct

@{
    ViewData["Title"] = "Chỉnh sửa danh mục sản phẩm";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4" style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="card-header border-0 py-4" style="background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 1rem 1rem 0 0;">
                    <h3 class="mb-0 fw-bold" style="background: linear-gradient(135deg, #f6c23e, #f4b619); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        <i class="fas fa-layer-group me-2" style="color: #f6c23e;"></i>
                        CHỈNH SỬA DANH MỤC
                        <span style="-webkit-text-fill-color: #64748b; font-size: 1rem; font-weight: 400;"> #@Model.Id</span>
                    </h3>
                </div>

                <div class="card-body p-4 text-light">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold" style="color: #e2e8f0;">Tên danh mục <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" placeholder="Nhập tên danh mục..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Description" class="form-label fw-bold" style="color: #e2e8f0;">Mô tả</label>
                            <textarea asp-for="Description" rows="4" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" placeholder="Nhập mô tả danh mục..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-warning px-4 py-2 rounded-pill fw-semibold border-0 text-dark" style="box-shadow: 0 4px 15px rgba(246, 194, 62, 0.3);">
                                <i class="fas fa-check-circle me-1"></i> Cập nhật
                            </button>
                            <a asp-action="Index" class="btn px-4 py-2 rounded-pill fw-semibold" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #f8fafc;">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
