@model IEnumerable<CMS.Data.Entities.CategoryProduct>

@{
    ViewData["Title"] = "Loại sản phẩm";
}

<div class="container-fluid px-0">
    <div class="saas-card">

        <!-- HEADER -->
        <div class="saas-card-header">
            <div>
                <h3 class="mb-0 text-white fw-bold">
                    <i class="fas fa-layer-group me-2"></i>DANH MỤC SẢN PHẨM
                </h3>
                <p class="text-white-50 small mb-0">Quản lý các nhóm phân loại sản phẩm</p>
            </div>
            <a asp-action="Create" class="btn btn-add-new">
                <i class="fas fa-plus-circle me-1"></i> Thêm danh mục
            </a>
        </div>

        <!-- TABLE -->
        <div class="p-0">
            <table class="table table-hover mb-0 saas-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4" style="width:8%">ID</th>
                        <th style="width:35%">Tên danh mục</th>
                        <th style="width:45%">Mô tả</th>
                        <th class="text-end pe-4" style="width:12%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-dark border">#@item.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="cat-icon">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <span class="fw-bold text-primary">@item.Name</span>
                                    </div>
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm border-0 mx-1" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm border-0 mx-1" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-layer-group fs-1 mb-3 d-block" style="opacity:.3;"></i>
                                Chưa có danh mục nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="saas-card-footer">
            <small class="text-muted">Hiển thị tổng số @(Model?.Count() ?? 0) danh mục</small>
        </div>
    </div>
</div>

@await Html.PartialAsync("_SaasTableStyle")

<style>
    .cat-icon {
        width: 32px; height: 32px;
        background: #EDE9FE; color: #7C3AED;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.8rem;
    }
</style>