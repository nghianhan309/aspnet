@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Xác nhận xóa đơn hàng";
    var statusText = Model.Status == 0 ? "Chờ duyệt" : Model.Status == 1 ? "Đang giao hàng" : "Hoàn thành";
    var statusColor = Model.Status == 0 ? "#f6c23e" : Model.Status == 1 ? "#36b9cc" : "#1cc88a";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4" style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08) !important;">

                <div class="card-body p-5 text-center text-light">
                    <i class="fas fa-exclamation-triangle mb-4" style="font-size: 5rem; color: #e74a3b;"></i>

                    <h2 class="fw-bold mb-3">XÁC NHẬN XÓA ĐƠN HÀNG?</h2>
                    <p class="text-secondary fs-5 mb-4">Đơn hàng <strong class="text-white">#@Model.Id</strong> sẽ bị xóa vĩnh viễn.</p>

                    <div class="bg-dark p-3 rounded-3 mb-4 text-start" style="border: 1px solid rgba(255,255,255,0.1);">
                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted">Khách hàng:</div>
                            <div class="col-sm-7 fw-bold">@(Model.Customer?.FullName ?? "---")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted">Ngày đặt:</div>
                            <div class="col-sm-7 fw-bold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-5 text-muted">Trạng thái:</div>
                            <div class="col-sm-7 fw-bold" style="color: @statusColor;">@statusText</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-5 text-muted">Ghi chú:</div>
                            <div class="col-sm-7">@(string.IsNullOrEmpty(Model.Notes) ? "Không có" : Model.Notes)</div>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold border-0" style="background: linear-gradient(135deg, #e74a3b, #c0392b); box-shadow: 0 4px 15px rgba(231, 74, 59, 0.3);">
                                <i class="fas fa-trash-alt me-1"></i> Có, xóa ngay
                            </button>
                            <a asp-action="Index" class="btn px-4 py-2 rounded-pill fw-semibold" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #f8fafc;">
                                <i class="fas fa-times me-1"></i> Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
