@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Đơn hàng";
    int total    = Model?.Count() ?? 0;
    int pending  = Model?.Count(o => o.Status == 0) ?? 0;
    int shipping = Model?.Count(o => o.Status == 1) ?? 0;
    int done     = Model?.Count(o => o.Status == 2) ?? 0;
}

<!-- STAT MINI CARDS -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="mini-stat" style="--c:#7C3AED;--cl:#EDE9FE;">
            <div class="mini-stat-icon"><i class="fas fa-shopping-cart"></i></div>
            <div>
                <div class="mini-stat-val">@total</div>
                <div class="mini-stat-lbl">Tổng đơn hàng</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="mini-stat" style="--c:#F59E0B;--cl:#FEF3C7;">
            <div class="mini-stat-icon"><i class="fas fa-clock"></i></div>
            <div>
                <div class="mini-stat-val">@pending</div>
                <div class="mini-stat-lbl">Chờ duyệt</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="mini-stat" style="--c:#3B82F6;--cl:#DBEAFE;">
            <div class="mini-stat-icon"><i class="fas fa-truck"></i></div>
            <div>
                <div class="mini-stat-val">@shipping</div>
                <div class="mini-stat-lbl">Đang giao</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="mini-stat" style="--c:#22C55E;--cl:#DCFCE7;">
            <div class="mini-stat-icon"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="mini-stat-val">@done</div>
                <div class="mini-stat-lbl">Hoàn thành</div>
            </div>
        </div>
    </div>
</div>

<!-- MAIN TABLE CARD -->
<div class="container-fluid px-0">
    <div class="saas-card">

        <!-- HEADER -->
        <div class="saas-card-header">
            <div>
                <h3 class="mb-0 text-white fw-bold">
                    <i class="fas fa-shopping-cart me-2"></i>QUẢN LÝ ĐƠN HÀNG
                </h3>
                <p class="text-white-50 small mb-0">Kiểm soát giao dịch và trạng thái đơn hàng</p>
            </div>
            <a asp-action="Create" class="btn btn-add-new">
                <i class="fas fa-plus-circle me-1"></i> Tạo đơn hàng
            </a>
        </div>

        <!-- TABLE -->
        <div class="p-0">
            <table class="table table-hover mb-0 saas-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4" style="width:7%">ID</th>
                        <th style="width:22%">Khách hàng</th>
                        <th style="width:15%">Ngày đặt</th>
                        <th style="width:15%">Trạng thái</th>
                        <th style="width:28%">Ghi chú</th>
                        <th class="text-end pe-4" style="width:13%">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string statusText, statusClass;
                            if      (item.Status == 0) { statusText = "Chờ duyệt";  statusClass = "badge-order-pending"; }
                            else if (item.Status == 1) { statusText = "Đang giao";  statusClass = "badge-order-shipping"; }
                            else                       { statusText = "Hoàn thành"; statusClass = "badge-order-done"; }

                            var initial = (item.Customer?.FullName ?? "?").Trim().Substring(0, 1).ToUpper();

                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-primary">#@item.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="cust-avatar-sm">@initial</div>
                                        <span class="fw-semibold text-dark">@(item.Customer?.FullName ?? "—")</span>
                                    </div>
                                </td>
                                <td class="text-muted">@item.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="order-status @statusClass">@statusText</span>
                                </td>
                                <td class="text-muted text-truncate" style="max-width:220px;">
                                    @(string.IsNullOrEmpty(item.Notes) ? "—" : item.Notes)
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm border-0 mx-1" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm border-0 mx-1" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-cart-arrow-down fs-1 mb-3 d-block" style="opacity:.3;"></i>
                                Chưa có đơn hàng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="saas-card-footer">
            <small class="text-muted">Hiển thị tổng số @total đơn hàng</small>
        </div>
    </div>
</div>

@await Html.PartialAsync("_SaasTableStyle")

<style>
    /* Mini stat cards */
    .mini-stat {
        background: white;
        border: 1px solid #E5E7EB;
        border-radius: 14px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        transition: transform .2s, box-shadow .2s;
    }
    .mini-stat:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,0.09); }
    .mini-stat-icon {
        width: 42px; height: 42px;
        background: var(--cl); color: var(--c);
        border-radius: 11px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; flex-shrink: 0;
    }
    .mini-stat-val { font-size: 1.5rem; font-weight: 800; color: #111827; line-height: 1; }
    .mini-stat-lbl { font-size: 0.75rem; color: #6B7280; font-weight: 500; }

    /* Customer avatar small */
    .cust-avatar-sm {
        width: 32px; height: 32px; border-radius: 50%;
        background: #EDE9FE; color: #7C3AED;
        font-weight: 700; font-size: 0.82rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    /* Order status badges */
    .order-status {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .badge-order-pending  { background: #FEF3C7; color: #D97706; }
    .badge-order-shipping { background: #DBEAFE; color: #2563EB; }
    .badge-order-done     { background: #DCFCE7; color: #16A34A; }
</style>