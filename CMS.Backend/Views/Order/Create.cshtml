@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Tạo đơn hàng mới";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4" style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="card-header border-0 py-4" style="background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 1rem 1rem 0 0;">
                    <h3 class="mb-0 fw-bold" style="background: linear-gradient(135deg, #1cc88a, #169b6b); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        <i class="fas fa-cart-plus me-2" style="color: #1cc88a;"></i>TẠO ĐƠN HÀNG MỚI
                    </h3>
                </div>

                <div class="card-body p-4 text-light">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="CustomerId" class="form-label fw-bold" style="color: #e2e8f0;">Khách hàng <span class="text-danger">*</span></label>
                            <select asp-for="CustomerId" asp-items="ViewBag.CustomerId" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;">
                                <option value="" class="text-dark">-- Chọn khách hàng --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-bold" style="color: #e2e8f0;">Trạng thái đơn hàng</label>
                            <select asp-for="Status" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;">
                                <option value="0" class="text-dark">⏳ Chờ duyệt</option>
                                <option value="1" class="text-dark">🚚 Đang giao hàng</option>
                                <option value="2" class="text-dark">✅ Hoàn thành</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Notes" class="form-label fw-bold" style="color: #e2e8f0;">Ghi chú</label>
                            <textarea asp-for="Notes" rows="3" class="form-control bg-transparent text-light" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 0.5rem; padding: 0.75rem;" placeholder="Nhập ghi chú đơn hàng..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn px-4 py-2 rounded-pill fw-semibold border-0" style="background: linear-gradient(135deg, #1cc88a, #169b6b); color: white; box-shadow: 0 4px 15px rgba(28, 200, 138, 0.3);">
                                <i class="fas fa-save me-1"></i> Tạo đơn hàng
                            </button>
                            <a asp-action="Index" class="btn px-4 py-2 rounded-pill fw-semibold" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #f8fafc;">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
