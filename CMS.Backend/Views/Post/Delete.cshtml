@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Xóa Bài viết";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3 border-danger" style="border-width: 2px !important;">
                <div class="card-header py-3 bg-danger text-white border-bottom-0" style="border-radius: 1rem 1rem 0 0;">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận Xóa Bài Viết</h4>
                </div>
                <div class="card-body p-4 bg-white">
                    <p class="fs-5 mb-4 text-dark">Bạn có chắc chắn muốn xóa bài viết <strong>@Model.Title</strong> không?</p>
                    <p class="text-muted"><i class="bi bi-info-circle me-1"></i>Hành động này không thể hoàn tác.</p>
                    
                    <div class="mt-4 border p-3 rounded bg-light">
                        <div class="row">
                            <div class="col-md-4">
                                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/150" : Model.ImageUrl)" class="img-fluid rounded shadow-sm" alt="Image" />
                            </div>
                            <div class="col-md-8">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4 text-secondary">Danh mục</dt>
                                    <dd class="col-sm-8 text-dark fw-bold">@(Model.Category?.Name ?? "N/A")</dd>

                                    <dt class="col-sm-4 text-secondary">Ngày tạo</dt>
                                    <dd class="col-sm-8 text-dark">@Model.CreatedDate.ToString("dd/MM/yyyy")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light p-4 pt-3 border-0 d-flex gap-2" style="border-radius: 0 0 1rem 1rem;">
                    <form asp-action="Delete" class="m-0">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="bi bi-trash-fill me-1"></i> Xóa vĩnh viễn
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-secondary px-4 fw-bold">
                        Hủy bỏ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
