@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Chi tiết Bài viết";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header Card -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1e3a5f, #1a2744); border-bottom: 1px solid rgba(56,189,248,0.2);">
                    <h5 class="mb-0 text-white"><i class="bi bi-file-text me-2" style="color: #38bdf8;"></i>Chi Tiết Bài Viết</h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
                
                <div class="card-body p-0">
                    <!-- Image Banner -->
                    <div class="position-relative" style="height: 400px; width: 100%; overflow: hidden;">
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/800x400" : Model.ImageUrl)" class="w-100 h-100" style="object-fit: cover;" alt="@Model.Title" />
                        <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(to top, rgba(15,23,42,0.95), transparent);">
                            <span class="badge" style="background-color: #38bdf8; color: #0f172a; font-weight: 700; padding: 6px 12px; font-size: 0.9rem;">@(Model.Category?.Name ?? "Tạp chí")</span>
                            <h1 class="text-white fw-bold mt-2 mb-0" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">@Model.Title</h1>
                        </div>
                    </div>

                    <!-- Content Section -->
                    <div class="p-5 bg-white">
                        <div class="d-flex align-items-center mb-4 text-muted border-bottom pb-3">
                            <div class="me-4">
                                <i class="bi bi-calendar3 text-primary me-2"></i> 
                                <span class="fw-medium">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div>
                                <i class="bi bi-person-circle text-primary me-2"></i> 
                                <span class="fw-medium">Quản trị viên (Admin)</span>
                            </div>
                        </div>

                        <div class="post-content" style="line-height: 1.8; font-size: 1.1rem; color: #334155; text-align: justify;">
                            @Html.Raw(Model.Content.Replace("\n", "<br/>"))
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 mt-5 pt-4 border-top">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa bài viết
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger px-4 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-trash me-1"></i> Xóa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .post-content p {
        margin-bottom: 1.5rem;
    }
</style>